# GeoLens Platform — Environment Variables
# Kopyala: cp .env.example .env

PORT=8080

# PostgreSQL
DATABASE_URL=postgres://geolens:geolens@localhost:5432/geolens?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379/0

# S3 (MinIO)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=geolens
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Auth
JWT_SECRET=dev-secret-change-in-production

# Logging
LOG_LEVEL=debug

# OpenTelemetry
OTEL_ENDPOINT=http://localhost:4318

# Scheduler
POLL_INTERVAL=30s
CONSUMER_GROUP=cg:measure

# Environment
ENVIRONMENT=development
