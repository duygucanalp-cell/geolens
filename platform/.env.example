# GeoLens Platform — Environment Variables
# Kopyala: cp .env.example .env

PORT=8080

# Worker Prometheus metrics port (0421 M-4 gözlemlenebilirlik)
# Worker kendi prosesindeki metrikleri (queue depth, engine calls, ML breaker
# sentiment/measure component'leri) bu portta /metrics olarak serve eder.
# API'nin :8080/metrics'inden ayrıdır. Prometheus: worker:8081/metrics.
WORKER_METRICS_PORT=8081
# Scheduler Prometheus metrics port (scheduler prosesi — :8080/:8081'den ayrı)
SCHEDULER_METRICS_PORT=8082

# PostgreSQL
DATABASE_URL=postgres://geolens:geolens@localhost:5432/geolens?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379/0

# S3 (MinIO)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=geolens
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Perplexity
PERPLEXITY_API_KEY=pplx-your-api-key-here

# Auth
JWT_SECRET=dev-secret-change-in-production

# Logging
LOG_LEVEL=debug

# OpenTelemetry
OTEL_ENDPOINT=http://localhost:4318

# Scheduler
POLL_INTERVAL=30s
CONSUMER_GROUP=cg:measure

# Environment
ENVIRONMENT=development

# ML Serving (0421 A0-3)
# Boş bırakılırsa kural tabanlı bileşenler fallback çalışır; doldurulursa
# ML serving API'ye inference çağrısı yapılır (0421 M-4: serving yoksa fallback).
# Docker compose içinde (api/worker servisleri): http://ml-serving:8900
# Yerel `go run` için (host'tan serving): http://localhost:8900
ML_SERVING_URL=http://ml-serving:8900
ML_TIMEOUT=5s

# LLM-as-Judge (0421 A2-5 — maliyet eşikli tetikleme)
# Boş bırakılırsa (varsayılan) kural tabanlı fallback çalışır; doldurulursa
# cross-source hallüsinasyon tespiti şüphe eşiğini aştığında OpenAI-uyumlu
# LLM yargıcı tetiklenir. serving'e (ml-serving) env olarak verilir.
# GEOLENS_JUDGE_API_KEY=sk-...
# GEOLENS_JUDGE_MODEL=gpt-4o-mini
# GEOLENS_JUDGE_BASE_URL=            # OpenAI dışı/yerel uyumlu uç nokta (opsiyonel)
# GEOLENS_JUDGE_THRESHOLD=3          # şüphe skoru eşiği (critical=3, high=2, medium/low=1)
# GEOLENS_JUDGE_TIMEOUT=20

# Motor ağırlıkları (0309 §6.2 — per-motor ağırlıklı weighted_average)
# Boş bırakılırsa varsayılan tablo kullanılır (Perplexity 0.30, ChatGPT 0.30,
# Gemini 0.25, Google AI Overview 0.10, Claude/Grok/Mistral/Copilot 0.05,
# Google AI Mode 0). Biçim: "engine=0.30,engine2=0.25,..." — pilot kalibrasyonu.
# ENGINE_WEIGHTS="perplexity=0.30,chatgpt=0.30,gemini=0.25,google_ai_overview=0.10,claude=0.05,grok=0.05,copilot=0.05"

# Intent ağırlık çarpanları (0421 A3-3 — pilot verisiyle kalibrasyon)
# Prompt intent'ine göre VI bileşen çarpanları. Boş bırakılırsa varsayılan tablo
# kullanılır (0404 §4). Biçim: "intent=v1,v2,v3,v4,v5,v6,v7;intent=..."
# Sıra: [varlık, konum, kaynak, rakip, appearance, sentiment, compvis]
# Örnek:
# INTENT_WEIGHT_SCALE="presence=1.25,1.00,0.90,0.90,1.10,0.90,0.90;comparison=0.90,1.00,0.90,1.40,0.90,0.90,1.30"
INTENT_WEIGHT_SCALE=

# Sektör benchmark eşiği (NFR-13 — diferansiyel gizlilik)
# Sektör istatistiklerinin yayınlanması için gereken minimum kiracı sayısı.
# Pilot döneminde 2-3'e düşürülebilir (küçük veri setiyle demo), üretimde ≥5 kalmalı.
BENCHMARK_MIN_TENANTS=5
