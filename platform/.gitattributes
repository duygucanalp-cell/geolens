# === Git LFS: ML model artefaktları (0421) ===
# Eğitilmiş model dosyaları ve ONNX export ürünleri LFS ile sürümlenir.
# Boyut eşiği ~10MB; tokenizer JSON da büyük olduğu için LFS'e alındı.
ml/models/**/*.onnx          filter=lfs diff=lfs merge=lfs -text
ml/models/**/*.onnx.data     filter=lfs diff=lfs merge=lfs -text
ml/models/**/model.pt        filter=lfs diff=lfs merge=lfs -text
ml/models/**/*.joblib        filter=lfs diff=lfs merge=lfs -text
ml/models/**/tokenizer.json  filter=lfs diff=lfs merge=lfs -text
ml/models/**/*.pt            filter=lfs diff=lfs merge=lfs -text