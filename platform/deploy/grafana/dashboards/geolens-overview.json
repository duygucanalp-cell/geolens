{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "11.3.1"
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    }
  ],
  "title": "GeoLens — Platform Overview",
  "uid": "geolens-overview",
  "version": 1,
  "timezone": "browser",
  "editable": true,
  "tags": ["geolens", "platform"],
  "schemaVersion": 39,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "title": "HTTP Request Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(geolens_http_requests_total[$__rate_interval]))",
          "legendFormat": "Total QPS"
        },
        {
          "expr": "sum(rate(geolens_http_requests_total{status=~\"5..\"}[$__rate_interval]))",
          "legendFormat": "5xx QPS"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "showPoints": "never" }
        }
      }
    },
    {
      "title": "HTTP Latency (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(geolens_http_request_duration_seconds_bucket[$__rate_interval])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(geolens_http_request_duration_seconds_bucket[$__rate_interval])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(geolens_http_request_duration_seconds_bucket[$__rate_interval])) by (le))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "showPoints": "never" }
        }
      }
    },
    {
      "title": "In-flight Requests",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 4, "x": 16, "y": 0 },
      "targets": [
        {
          "expr": "geolens_http_requests_in_flight",
          "legendFormat": "In-flight"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "showPoints": "never" }
        }
      }
    },
    {
      "title": "Error Rate (4xx / 5xx)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 4, "x": 20, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(geolens_http_requests_total{status=~\"4..\"}[$__rate_interval]))",
          "legendFormat": "4xx"
        },
        {
          "expr": "sum(rate(geolens_http_requests_total{status=~\"5..\"}[$__rate_interval]))",
          "legendFormat": "5xx"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "showPoints": "never" }
        }
      }
    },
    {
      "title": "Engine Calls by Engine",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(geolens_engine_calls_total[$__rate_interval])) by (engine)",
          "legendFormat": "{{engine}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "showPoints": "never" }
        }
      }
    },
    {
      "title": "Engine Call Duration",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(geolens_engine_call_duration_seconds_bucket[$__rate_interval])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(geolens_engine_call_duration_seconds_bucket[$__rate_interval])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(geolens_engine_call_duration_seconds_bucket[$__rate_interval])) by (le))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "showPoints": "never" }
        }
      }
    },
    {
      "title": "Engine Error Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 4, "x": 16, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(geolens_engine_calls_failed_total[$__rate_interval])) by (engine)",
          "legendFormat": "{{engine}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "showPoints": "never" }
        }
      }
    },
    {
      "title": "Engine Response Size",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 4, "x": 20, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(geolens_engine_response_size_bytes_bucket[$__rate_interval])) by (le))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "showPoints": "never" }
        }
      }
    },
    {
      "title": "Queue Depth by Stream",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "geolens_queue_depth",
          "legendFormat": "{{stream}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "showPoints": "never" }
        }
      }
    },
    {
      "title": "Queue Throughput",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "targets": [
        {
          "expr": "sum(rate(geolens_queue_messages_produced_total[$__rate_interval]))",
          "legendFormat": "Produced"
        },
        {
          "expr": "sum(rate(geolens_queue_messages_consumed_total[$__rate_interval]))",
          "legendFormat": "Consumed"
        },
        {
          "expr": "sum(rate(geolens_queue_messages_failed_total[$__rate_interval]))",
          "legendFormat": "Failed"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "showPoints": "never" }
        }
      }
    },
    {
      "title": "Queue Processing Duration",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 4, "x": 16, "y": 16 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(geolens_queue_processing_duration_seconds_bucket[$__rate_interval])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(geolens_queue_processing_duration_seconds_bucket[$__rate_interval])) by (le))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "showPoints": "never" }
        }
      }
    },
    {
      "title": "Dead Letter Queue Size",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 4, "x": 20, "y": 16 },
      "targets": [
        {
          "expr": "geolens_queue_dead_letter_size",
          "legendFormat": "{{stream}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "showPoints": "never" }
        }
      }
    },
    {
      "title": "Active Users by Tenant",
      "type": "bargauge",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 24 },
      "targets": [
        {
          "expr": "geolens_active_users",
          "legendFormat": "{{tenant}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0
        }
      }
    },
    {
      "title": "Total Brands by Tenant",
      "type": "bargauge",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 24 },
      "targets": [
        {
          "expr": "geolens_total_brands",
          "legendFormat": "{{tenant}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0
        }
      }
    },
    {
      "title": "Completed Measurements by Tenant",
      "type": "bargauge",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 24 },
      "targets": [
        {
          "expr": "geolens_measurements_completed",
          "legendFormat": "{{tenant}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0
        }
      }
    },
    {
      "title": "Completed Audits by Tenant",
      "type": "bargauge",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 24 },
      "targets": [
        {
          "expr": "geolens_audits_completed",
          "legendFormat": "{{tenant}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0
        }
      }
    },
    {
      "title": "Recommendations Generated by Tenant",
      "type": "bargauge",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 30 },
      "targets": [
        {
          "expr": "geolens_recommendations_generated",
          "legendFormat": "{{tenant}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0
        }
      }
    },
    {
      "title": "Emails Sent by Tenant",
      "type": "bargauge",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 30 },
      "targets": [
        {
          "expr": "geolens_emails_sent",
          "legendFormat": "{{tenant}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0
        }
      }
    },
    {
      "title": "ML Serving Breaker — Cooldown State",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 36 },
      "description": "geolens_ml_breaker_in_cooldown — 1 = serving erişilemez (devre kesici açık), 0 = normal. Herhangi bir component 1'de kalırsa ML serving down demektir (MLServingUnavailable alarmı).",
      "targets": [
        {
          "expr": "sum(geolens_ml_breaker_in_cooldown{component=\"sentiment\"}) by (job)",
          "legendFormat": "sentiment ({{job}})"
        },
        {
          "expr": "sum(geolens_ml_breaker_in_cooldown{component=\"measure\"}) by (job)",
          "legendFormat": "measure ({{job}})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bool",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "custom": { "showPoints": "never" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "sentiment" },
            "properties": [
              { "id": "custom.lineWidth", "value": 2 },
              { "id": "custom.lineStyle", "value": { "fill": "solid" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "measure" },
            "properties": [
              { "id": "custom.lineWidth", "value": 2 },
              { "id": "custom.lineStyle", "value": { "fill": "solid" } }
            ]
          }
        ]
      }
    },
    {
      "title": "ML Serving Breaker — Failures",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 36 },
      "description": "geolens_ml_breaker_failures_total — serving ardışık hatasında devre kesicinin açılma (Fail) sayısı. Kümülatif counter; artış hızı serving stabilitesini gösterir.",
      "targets": [
        {
          "expr": "sum(increase(geolens_ml_breaker_failures_total{component=\"sentiment\"}[$__rate_interval])) by (job)",
          "legendFormat": "sentiment ({{job}})"
        },
        {
          "expr": "sum(increase(geolens_ml_breaker_failures_total{component=\"measure\"}[$__rate_interval])) by (job)",
          "legendFormat": "measure ({{job}})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": { "showPoints": "never" }
        }
      }
    }
  ]
}
